{
    "name": "yassrzg/ckeditor-dsfr-bundle",
    "description": "Éditeur CKEditor 5 à composants DSFR (cartes, tuiles, boutons, accordéons, onglets, vidéos…), médiathèque et réglages administrables pour Symfony.",
    "type": "symfony-bundle",
    "license": "GPL-2.0-or-later",
    "keywords": ["symfony", "bundle", "symfony-ux", "ckeditor", "dsfr", "stimulus", "asset-mapper"],
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.3|^4.0",
        "doctrine/orm": "^3.3",
        "masterminds/html5": "^2.9",
        "symfony/asset": "^7.4|^8.0",
        "symfony/asset-mapper": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/form": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/html-sanitizer": "^7.4|^8.0",
        "symfony/mime": "^7.4|^8.0",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/security-bundle": "^7.4|^8.0",
        "symfony/security-csrf": "^7.4|^8.0",
        "symfony/stimulus-bundle": "^2.24|^3.0",
        "symfony/string": "^7.4|^8.0",
        "symfony/twig-bundle": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/css-selector": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Yassrzg\\CkeditorDsfrBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yassrzg\\CkeditorDsfrBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
