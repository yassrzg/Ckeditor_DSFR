{# Pagination DSFR (page courante et deux pages de part et d'autre, première et dernière). #}
{% macro pagination(route, params, currentPage, totalPages) %}
    {% if totalPages > 1 %}
        {% set pages = [1, totalPages]|merge(range(max(1, currentPage - 2), min(totalPages, currentPage + 2)))|sort|reduce((carry, p) => p in carry ? carry : carry|merge([p]), []) %}
        <nav role="navigation" class="fr-pagination fr-mt-6v" aria-label="Pagination">
            <ul class="fr-pagination__list">
                <li>
                    {% if currentPage > 1 %}
                        <a class="fr-pagination__link fr-pagination__link--prev fr-pagination__link--lg-label" href="{{ path(route, params|merge({page: currentPage - 1})) }}">Page précédente</a>
                    {% else %}
                        <a class="fr-pagination__link fr-pagination__link--prev fr-pagination__link--lg-label" aria-disabled="true" role="link">Page précédente</a>
                    {% endif %}
                </li>
                {% for page in pages %}
                    {% if not loop.first and page > pages[loop.index0 - 1] + 1 %}
                        <li><span class="fr-pagination__link" aria-hidden="true">…</span></li>
                    {% endif %}
                    <li><a class="fr-pagination__link" href="{{ path(route, params|merge({page: page})) }}" title="Page {{ page }}"{% if page == currentPage %} aria-current="page"{% endif %}>{{ page }}</a></li>
                {% endfor %}
                <li>
                    {% if currentPage < totalPages %}
                        <a class="fr-pagination__link fr-pagination__link--next fr-pagination__link--lg-label" href="{{ path(route, params|merge({page: currentPage + 1})) }}">Page suivante</a>
                    {% else %}
                        <a class="fr-pagination__link fr-pagination__link--next fr-pagination__link--lg-label" aria-disabled="true" role="link">Page suivante</a>
                    {% endif %}
                </li>
            </ul>
        </nav>
    {% endif %}
{% endmacro %}

{# Bouton qui ouvre une fenêtre de confirmation DSFR ; la confirmation envoie un formulaire POST protégé (CSRF). #}
{% macro confirm_action(id, action, csrf_id, options = {}) %}
    {% set o = {label: 'Supprimer', btn_class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-btn--icon-left fr-icon-delete-line', title: 'Confirmation', message: 'Confirmez-vous cette action ?', confirm_label: 'Confirmer'}|merge(options) %}
    <button type="button" data-fr-opened="false" aria-controls="modal-{{ id }}" class="{{ o.btn_class }}">{{ o.label }}</button>
    <dialog id="modal-{{ id }}" class="fr-modal" aria-labelledby="modal-{{ id }}-title">
        <div class="fr-container fr-container--fluid fr-container-md">
            <div class="fr-grid-row fr-grid-row--center">
                <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
                    <form class="fr-modal__body" method="post" action="{{ action }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                        <div class="fr-modal__header">
                            <button type="button" class="fr-btn--close fr-btn" title="Fermer" aria-controls="modal-{{ id }}">Fermer</button>
                        </div>
                        <div class="fr-modal__content">
                            <h1 id="modal-{{ id }}-title" class="fr-modal__title"><span class="fr-icon-alert-fill fr-mr-2v" aria-hidden="true"></span>{{ o.title }}</h1>
                            <p>{{ o.message }}</p>
                        </div>
                        <div class="fr-modal__footer">
                            <div class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg">
                                <button type="submit" class="fr-btn">{{ o.confirm_label }}</button>
                                <button type="button" class="fr-btn fr-btn--secondary" aria-controls="modal-{{ id }}">Annuler</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </dialog>
{% endmacro %}
