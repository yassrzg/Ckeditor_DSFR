{% extends '@CkeditorDsfr/admin/_layout.html.twig' %}
{% import '@CkeditorDsfr/admin/_macros.html.twig' as ui %}

{% block ckeditor_dsfr_title %}Médiathèque{% endblock %}

{% block ckeditor_dsfr_content %}
    <div class="cmp-admin-header">
        <h1 class="fr-h2">Médiathèque</h1>
        <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--icon-left">
            <li><a class="fr-btn fr-btn--icon-left fr-icon-image-add-line" href="{{ path('ckeditor_dsfr_media_create', {type: 'image'}) }}">Ajouter une image</a></li>
            <li><a class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-file-add-line" href="{{ path('ckeditor_dsfr_media_create', {type: 'document'}) }}">Ajouter un document</a></li>
            <li><a class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-film-line" href="{{ path('ckeditor_dsfr_media_create', {type: 'video'}) }}">Ajouter une vidéo</a></li>
            {% if ckeditor_dsfr_is_granted('settings') %}
                <li><a class="fr-btn fr-btn--tertiary fr-btn--icon-left fr-icon-settings-5-line" href="{{ path('ckeditor_dsfr_settings') }}">Réglages de l’éditeur</a></li>
            {% endif %}
        </ul>
    </div>
    <p class="fr-text--sm">Images, documents et vidéos utilisables dans l’éditeur. Un média utilisé par un contenu ne peut pas être supprimé.</p>

    <div class="cmp-admin-filters fr-mb-4v">
        <nav aria-label="Catégorie de média">
            <ul class="fr-tags-group">
                <li><a class="fr-tag" href="{{ path('ckeditor_dsfr_media_index', {q: q}) }}"{% if type is null %} aria-current="true"{% endif %}>Tous ({{ counts|reduce((sum, n) => sum + n, 0) }})</a></li>
                {% for case in types %}
                    <li><a class="fr-tag" href="{{ path('ckeditor_dsfr_media_index', {type: case.value, q: q}) }}"{% if type == case %} aria-current="true"{% endif %}>{{ case.pluralLabel }} ({{ counts[case.value] }})</a></li>
                {% endfor %}
            </ul>
        </nav>
        <form method="get" action="{{ path('ckeditor_dsfr_media_index') }}" role="search" class="fr-search-bar" id="media-search">
            {% if type %}<input type="hidden" name="type" value="{{ type.value }}">{% endif %}
            <label class="fr-label" for="media-search-input">Rechercher un média</label>
            <input class="fr-input" type="search" id="media-search-input" name="q" value="{{ q }}" placeholder="Rechercher un média" maxlength="100">
            <button class="fr-btn" type="submit" title="Rechercher un média">Rechercher</button>
        </form>
    </div>

    {% if medias is empty %}
        <div class="fr-alert fr-alert--info fr-alert--sm"><p>{{ q ? 'Aucun média ne correspond à « ' ~ q ~ ' ».' : 'La médiathèque est vide.' }}</p></div>
    {% else %}
        <p class="fr-text--sm">{{ total }} média{{ total > 1 ? 's' }}{% if pages > 1 %} — page {{ page }} sur {{ pages }}{% endif %}</p>
        <ul class="fr-grid-row fr-grid-row--gutters fr-raw-list" aria-label="Médias">
            {% for media in medias %}
                <li class="fr-col-12 fr-col-sm-6 fr-col-lg-3">
                    <div class="fr-card fr-card--sm fr-enlarge-link cmp-media-card">
                        <div class="fr-card__body">
                            <div class="fr-card__content">
                                <h2 class="fr-card__title"><a href="{{ path('ckeditor_dsfr_media_edit', {id: media.id}) }}">{{ media.title }}</a></h2>
                                <div class="fr-card__start"><p class="fr-badge fr-badge--sm fr-badge--{{ {image: 'info', document: 'new', video: 'purple-glycine'}[media.type.value] }} fr-badge--no-icon">{{ media.type.label }}</p></div>
                                <div class="fr-card__end"><p class="fr-card__detail">{{ media.detail }}{% if media.width %} · {{ media.width }}×{{ media.height }}{% endif %}</p></div>
                            </div>
                        </div>
                        <div class="fr-card__header">
                            {% if media.image %}
                                <div class="fr-card__img"><img class="fr-responsive-img fr-ratio-16x9 cmp-img" src="{{ path('ckeditor_dsfr_media_show', {id: media.id}) }}" alt="" loading="lazy"></div>
                            {% else %}
                                <div class="cmp-media-card__file" aria-hidden="true"><span class="{{ media.type.icon }} fr-icon--lg"></span><span>{{ media.format }}</span></div>
                            {% endif %}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
        {{ ui.pagination('ckeditor_dsfr_media_index', {q: q}|merge(type ? {type: type.value} : {}), page, pages) }}
    {% endif %}
{% endblock %}
