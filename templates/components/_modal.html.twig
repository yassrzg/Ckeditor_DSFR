{# Fenêtre modale DSFR d'un bouton « Bouton avec fenêtre » (variable c : le composant) ; titre et contenu rédigés dans l'éditeur. #}
{% set id = c.id ~ '-modal' %}
{% set col = {sm: 'fr-col-12 fr-col-md-6 fr-col-lg-4', md: 'fr-col-12 fr-col-md-8 fr-col-lg-6', lg: 'fr-col-12 fr-col-md-10 fr-col-lg-8'}[c.values['modal-size']] %}
<dialog id="{{ id }}" class="fr-modal" aria-labelledby="{{ id }}-title">
    <div class="fr-container fr-container--fluid fr-container-md">
        <div class="fr-grid-row fr-grid-row--center">
            <div class="{{ col }}">
                <div class="fr-modal__body">
                    <div class="fr-modal__header">
                        <button type="button" class="fr-btn--close fr-btn" title="Fermer" aria-controls="{{ id }}">Fermer</button>
                    </div>
                    <div class="fr-modal__content">
                        <h2 id="{{ id }}-title" class="fr-modal__title">{{ c.slots.title|raw }}</h2>
                        {{ c.slots.body|raw }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</dialog>
